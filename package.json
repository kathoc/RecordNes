{
  "name": "recordnes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NES emulator built around play recording and replay",
  "license": "MIT",
  "author": "kathoc",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "electron": "npm run build && electron .",
    "test": "node --experimental-strip-types --test --test-reporter=tap test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "dev:electron": "RECORDNES_DEV=1 electron ."
  },
  "dependencies": {
    "@nesjs/core": "2.7.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}